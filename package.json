{
  "name": "dsh-opencode-session",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: automatically adds a stable per-conversation x-opencode-session header to OpenCode / OpenCode Go provider requests — fixes 400 MissingSessionID and keeps OpenCode's session affinity / prompt-cache routing working.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/test.mjs && node tests/models.test.mjs",
    "models:refresh": "node scripts/refresh-opencode-models.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "opencode",
    "opencode-go",
    "opencode-zen",
    "x-opencode-session",
    "missing-session-id",
    "session-affinity",
    "prompt-cache",
    "llm"
  ],
  "license": "MIT",
  "author": {
    "name": "nobu121"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nobu121/dsh-opencode-session.git"
  },
  "homepage": "https://github.com/nobu121/dsh-opencode-session",
  "bugs": {
    "url": "https://github.com/nobu121/dsh-opencode-session/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
